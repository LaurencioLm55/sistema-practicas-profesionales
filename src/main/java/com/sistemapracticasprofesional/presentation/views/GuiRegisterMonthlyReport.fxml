<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sistemapracticasprofesional.presentation.controllersGui.RegisterMonthlyReportGuiController"
            stylesheets="@../../../resources/styles/styles.css">
   <top>
      <VBox alignment="CENTER" prefHeight="125.0" style="-fx-background-color: #00529e;">
         <padding>
            <Insets left="25.0" right="25.0" />
         </padding>
         <children>
            <HBox alignment="CENTER">
               <children>
                  <Label text="Registrar Reporte Mensual" textFill="WHITE" styleClass="header-title">
                     <font>
                        <Font name="Segoe UI Bold" size="38.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <ImageView fitHeight="100.0" fitWidth="120.0" preserveRatio="true">
                     <image>
                        <Image url="@../../../resources/images/LogoUv.jpg" />
                     </image>
                  </ImageView>
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" style="-fx-background-color: #f0f4f8;" BorderPane.alignment="CENTER">
         <content>
            <VBox alignment="TOP_CENTER" spacing="16.0" style="-fx-background-color: #f0f4f8;">
               <padding>
                  <Insets top="24.0" left="40.0" right="40.0" bottom="24.0" />
               </padding>
               <children>

                  <!-- Dates and description card -->
                  <VBox styleClass="form-card" spacing="12.0">
                     <children>
                        <Label text="Datos del reporte mensual" styleClass="subsection-title" />
                        <Separator />

                        <HBox alignment="CENTER_LEFT" spacing="16.0">
                           <children>
                              <Label text="Fecha de realización:" prefWidth="220.0" />
                              <DatePicker fx:id="completionDatePicker" styleClass="date-picker" />
                           </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="16.0">
                           <children>
                              <Label text="Fecha de entrega:" prefWidth="220.0" />
                              <DatePicker fx:id="deliveryDatePicker" styleClass="date-picker" />
                           </children>
                        </HBox>

                        <HBox alignment="TOP_LEFT" spacing="16.0">
                           <children>
                              <Label text="Descripción general:" prefWidth="220.0" />
                              <TextArea fx:id="descriptionArea" promptText="Describe las actividades realizadas en el mes..."
                                        prefHeight="100.0" wrapText="true" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Activity form card -->
                  <VBox styleClass="form-card" spacing="12.0">
                     <children>
                        <Label text="Agregar Actividad del Mes" styleClass="subsection-title" />
                        <Separator />

                        <HBox alignment="CENTER_LEFT" spacing="16.0">
                           <children>
                              <Label text="Nombre de actividad:" prefWidth="220.0" />
                              <TextField fx:id="activityNameField" promptText="Ej. Análisis de requerimientos" styleClass="text-input" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>

                        <HBox alignment="TOP_LEFT" spacing="16.0">
                           <children>
                              <Label text="Descripción:" prefWidth="220.0" />
                              <TextArea fx:id="activityDescriptionArea" promptText="Describe la actividad..."
                                        prefHeight="80.0" wrapText="true" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#handleAddActivity" styleClass="btn-primary" text="Agregar actividad" />
                              <Button mnemonicParsing="false" onAction="#handleRemoveActivity" styleClass="btn-secondary" text="Eliminar seleccionada" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Activity list card -->
                  <VBox styleClass="form-card" spacing="12.0">
                     <children>
                        <Label text="Actividades agregadas" styleClass="subsection-title" />
                        <Separator />
                        <ListView fx:id="activitiesListView" prefHeight="140.0" />
                     </children>
                  </VBox>

                  <Separator />

                  <HBox alignment="CENTER" spacing="20.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#handleGenerateReport" prefWidth="200.0" styleClass="btn-primary" text="Generar Reporte PDF" />
                        <Button mnemonicParsing="false" onAction="#handleBack" prefWidth="150.0" styleClass="btn-secondary" text="Cancelar" />
                     </children>
                  </HBox>

               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
